+/**
+ * Resolve the PHC readiness file path for a given source clock.
+ *
+ * @param src_name  Source clock device name (e.g., "/dev/ptp0" or "eth0")
+ * @param path      Output buffer for the resolved path
+ * @param pathlen   Size of the output buffer
+ * @return  0 on success, -1 if the source has no associated readiness file
+ */
+static int resolve_phc_ready_path(const char *src_name, char *path, size_t pathlen)
+{
+	char phc_device[PHC_DEVICE_LEN];
+
+	/* For CLOCK_REALTIME or non-PHC sources, there's no ts2phc
+	 * readiness file to wait for. */
+	if (!src_name || !strncmp(src_name, "CLOCK_REALTIME", 14))
+		return -1;
+
+	/* If the source is a /dev/ptp* path, use its basename directly.
+	 * Otherwise, treat it as a network interface name and resolve
+	 * the underlying PHC device via ethtool ioctl. */
+	if (src_name[0] == '/') {
+		const char *base = strrchr(src_name, '/');
+		base = base ? base + 1 : src_name;
+		if (snprintf(path, pathlen, "%s/%s.ready",
+			     PHC_READY_DIR, base) >= (int)pathlen) {
+			pr_err("PHC ready path too long for %s", src_name);
+			return -1;
+		}
+	} else {
+		struct sk_ts_info ts_info;
+
+		if (sk_get_ts_info(src_name, &ts_info) || !ts_info.valid ||
+		    ts_info.phc_index < 0) {
+			pr_warning("cannot resolve PHC for interface %s, "
+				   "skipping readiness check", src_name);
+			return -1;
+		}
+		snprintf(phc_device, sizeof(phc_device), "ptp%d",
+			 ts_info.phc_index);
+		if (snprintf(path, pathlen, "%s/%s.ready",
+			     PHC_READY_DIR, phc_device) >= (int)pathlen) {
+			pr_err("PHC ready path too long for %s", src_name);
+			return -1;
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * Non-blocking check for PHC readiness file.
+ *
+ * @param path  Path to the readiness file
+ * @return  1 if readiness file exists, 0 otherwise
+ */
+static int check_phc_ready(const char *path)
+{
+	return access(path, F_OK) == 0;
+}
+
 static int do_loop(struct domain *domains, int n_domains)
 {
 	int i, state_changed, prev_sub;
@@ -1747,6 +1815,22 @@ static int do_loop(struct domain *domains, int n_domains)
 	while (is_running()) {
 		clock_nanosleep(CLOCK_MONOTONIC, 0, &interval, NULL);
 
+		/* Check if any domain is waiting for PHC readiness */
+		for (i = 0; i < n_domains; i++) {
+			if (domains[i].phc_ready_pending &&
+			    check_phc_ready(domains[i].phc_ready_path)) {
+				pr_notice("PHC readiness confirmed: %s",
+					  domains[i].phc_ready_path);
+				pr_notice("restoring UTC offset correction "
+					  "(-O 0 -> -O %d)",
+					  domains[i].phc_ready_offset);
+				pmc_agent_set_sync_offset(
+					domains[i].agent,
+					domains[i].phc_ready_offset);
+				domains[i].phc_ready_pending = 0;
+			}
+		}
+
 		state_changed = 0;
 		src_domain = domains[0].src_domain;
 		if (!clock_gettime(CLOCK_MONOTONIC, &tp)) {
@@ -2751,6 +2835,41 @@ int main(int argc, char *argv[])
 		servo_sync_interval(dst->servo, 1.0);
 		r = do_pps_loop(&domains[0], dst, pps_fd);
 	} else {
+		/*
+		 * PHC readiness gate: check if ts2phc has confirmed that
+		 * the source PHC has been disciplined to TAI. If not ready
+		 * yet, suppress the UTC offset and let do_loop() re-check
+		 * on each poll iteration until readiness is confirmed.
+		 */
+		if (!autocfg && src_cnt > 0 &&
+		    domains[0].forced_sync_offset) {
+			if (!resolve_phc_ready_path(src_names[0],
+			    domains[0].phc_ready_path,
+			    sizeof(domains[0].phc_ready_path))) {
+				if (check_phc_ready(domains[0].phc_ready_path)) {
+					pr_notice("PHC readiness confirmed: %s",
+						  domains[0].phc_ready_path);
+				} else {
+					pr_info("PHC not yet ready (%s), "
+						"suppressing UTC offset "
+						"correction (-O %d -> -O 0) "
+						"until readiness is confirmed",
+						domains[0].phc_ready_path,
+						offset);
+					for (i = 0; i < n_domains; i++) {
+						pmc_agent_set_sync_offset(
+							domains[i].agent, 0);
+						domains[i].phc_ready_pending = 1;
+						domains[i].phc_ready_offset = offset;
+						/* All non-autocfg domains share the same -s source,
+						 * so they all use the same readiness path. */
+						memcpy(domains[i].phc_ready_path,
+						       domains[0].phc_ready_path,
+						       sizeof(domains[i].phc_ready_path));
+					}
+				}
+			}
+		}
 		r = do_loop(domains, n_domains);
 	}
 
