+/**
+ * Extract the PHC device basename from a device path like "/dev/ptp0".
+ * Returns pointer to the basename portion (e.g., "ptp0").
+ */
+static const char *phc_basename(const char *name)
+{
+	const char *p = strrchr(name, '/');
+	return p ? p + 1 : name;
+}
+
+/**
+ * Write a readiness file to signal that the PHC has reached
+ * SERVO_LOCKED or SERVO_JUMP.
+ * File path: /run/ptp-ready/<phc_device>.ready
+ */
+static void ts2phc_write_ready_file(const char *phc_device)
+{
+	char path[PATH_MAX];
+	struct timespec ts;
+	FILE *fp;
+
+	if (mkdir(PHC_READY_DIR, 0755) && errno != EEXIST) {
+		pr_err("failed to create %s: %m", PHC_READY_DIR);
+		return;
+	}
+
+	snprintf(path, sizeof(path), "%s/%s.ready",
+		 PHC_READY_DIR, phc_basename(phc_device));
+
+	fp = fopen(path, "w");
+	if (!fp) {
+		pr_err("failed to write readiness file %s: %m", path);
+		return;
+	}
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	if (fprintf(fp, "timestamp=%ld.%09ld\nservo_state=SERVO_LOCKED\n",
+		    (long)ts.tv_sec, ts.tv_nsec) < 0) {
+		pr_err("failed to write readiness file %s: %m", path);
+	}
+	fclose(fp);
+
+	pr_notice("PHC readiness file written: %s", path);
+}
+
+/**
+ * Remove stale readiness files for the devices managed by this instance.
+ * Only removes .ready files corresponding to clocks in priv->clocks,
+ * leaving files from other ts2phc instances untouched.
+ */
+static void ts2phc_remove_all_ready_files(struct ts2phc_private *priv)
+{
+	struct ts2phc_clock *c;
+	char path[PATH_MAX];
+
+	LIST_FOREACH(c, &priv->clocks, list) {
+		snprintf(path, sizeof(path), "%s/%s.ready",
+			 PHC_READY_DIR, phc_basename(c->name));
+
+		if (unlink(path) == 0)
+			pr_info("removed stale readiness file: %s", path);
+	}
+}
+
 static void ts2phc_synchronize_clocks(struct ts2phc_private *priv, int autocfg)
 {
 	struct timespec source_ts, now;
@@ -544,12 +611,23 @@ static void ts2phc_synchronize_clocks(struct ts2phc_private *priv, int autocfg)
 			if (clockadj_step(c->clkid, -offset)) {
 				goto servo_unlock;
 			}
+			/* After the jump, PHC-to-TAI error is within servo
+			 * pull-in range; phc2sys's own servo will handle the
+			 * residual offset from here. */
+			if (!c->ready_written) {
+				ts2phc_write_ready_file(c->name);
+				c->ready_written = true;
+			}
 			break;
 		case SERVO_LOCKED:
 		case SERVO_LOCKED_STABLE:
 			if (llabs(offset) < 500) {
 				c->current_offset_skip_count = 0;
 			}
+			if (!c->ready_written) {
+				ts2phc_write_ready_file(c->name);
+				c->ready_written = true;
+			}
 			if (clockadj_set_freq(c->clkid, -adj)) {
 				goto servo_unlock;
 			}
@@ -884,6 +962,9 @@ int main(int argc, char *argv[])
 
 	priv.holdover_length = config_get_int(cfg, NULL, "ts2phc.holdover");
 	priv.holdover_start = 0;
+
+	/* Remove stale readiness files from previous runs */
+	ts2phc_remove_all_ready_files(&priv);
 	priv.mon.fd = -1;
 	priv.mon.path = NULL;
 	mon_socket_open(config_get_string(cfg, NULL, "mon_socket_path"),
