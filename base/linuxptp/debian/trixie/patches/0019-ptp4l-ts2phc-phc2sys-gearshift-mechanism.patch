+int pmc_agent_service_requests(struct pmc_agent *agent)
+{
+	struct management_tlv *mgt;
+	struct ptp_message *msg;
+	int action;
+	struct pollfd pfd;
+
+	if (!agent->pmc)
+		return 0;
+
+	pfd.fd = pmc_get_transport_fd(agent->pmc);
+	pfd.events = POLLIN | POLLPRI;
+	if (poll(&pfd, 1, 0) <= 0)
+		return 0;
+	if (!(pfd.revents & (POLLIN | POLLPRI)))
+		return 0;
+
+	msg = pmc_recv(agent->pmc);
+	if (!msg)
+		return 0;
+
+	if (msg_type(msg) != MANAGEMENT) {
+		msg_put(msg);
+		return 0;
+	}
+
+	action = management_action(msg);
+	if (action != GET && action != SET) {
+		msg_put(msg);
+		return 0;
+	}
+
+	mgt = (struct management_tlv *) msg->management.suffix;
+
+	if (agent->management_handler)
+		agent->management_handler(agent->management_context,
+					  agent->pmc, msg, action, mgt->id);
+
+	msg_put(msg);
+	return 0;
+}
+
+int pmc_agent_get_fd(struct pmc_agent *agent)
+{
+	if (!agent->pmc)
+		return -1;
+	return pmc_get_transport_fd(agent->pmc);
+}
+
+void pmc_agent_set_management_handler(struct pmc_agent *agent,
+				      pmc_node_management_handler_t *handler,
+				      void *context)
+{
+	agent->management_handler = handler;
+	agent->management_context = context;
+}
