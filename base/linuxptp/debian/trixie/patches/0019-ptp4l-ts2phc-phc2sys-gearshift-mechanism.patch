+int pmc_send_response(struct pmc *pmc, struct ptp_message *req,
+		      int id, const void *data, int datalen)
+{
+	struct management_tlv *mgt;
+	struct tlv_extra *extra;
+	struct ptp_message *rsp;
+	int pdulen, padded;
+
+	rsp = pmc_message(pmc, RESPONSE);
+	if (!rsp)
+		return -1;
+
+	rsp->management.targetPortIdentity = req->header.sourcePortIdentity;
+	rsp->header.sequenceId = req->header.sequenceId;
+
+	padded = datalen + (datalen % 2);
+	mgt = (struct management_tlv *) rsp->management.suffix;
+	mgt->type = TLV_MANAGEMENT;
+	mgt->length = sizeof(mgt->id) + padded;
+	mgt->id = id;
+	if (datalen > 0)
+		memcpy(mgt->data, data, datalen);
+	if (padded > datalen)
+		mgt->data[datalen] = 0;
+
+	pdulen = rsp->header.messageLength + sizeof(*mgt) + padded;
+	rsp->header.messageLength = pdulen;
+
+	extra = tlv_extra_alloc();
+	if (!extra) {
+		msg_put(rsp);
+		return -ENOMEM;
+	}
+	extra->tlv = (struct TLV *) rsp->management.suffix;
+	msg_tlv_attach(rsp, extra);
+
+	pmc_send(pmc, rsp);
+	msg_put(rsp);
+	return 0;
+}
