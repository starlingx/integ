+ * #define GEAR_DRIVE_INDICATOR		"    "
+ */
+
+#define GEAR_INITIALS				((char *)"PND")
+#define GEAR_PARK_CHOICE			"P"
+#define GEAR_NEUTRAL_CHOICE			"N"
+#define GEAR_DRIVE_CHOICE			"D"
+
+/* Inline functions for checking gear status, used in multiple .c files */
+static inline bool gear_allows_adjust(enum gear_mode g)
+{
+	return g == GEAR_DRIVE;
+}
+static inline bool gear_is_park(enum gear_mode g)
+{
+	return g == GEAR_PARK;
