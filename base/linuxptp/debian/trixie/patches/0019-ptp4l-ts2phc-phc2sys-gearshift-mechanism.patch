+			/* Reset servo when re-engaging Drive from Park so the
+			 * servo starts fresh rather than resuming stale state.
+			 */
+			if (priv->gear != new_gear && new_gear == GEAR_DRIVE) {
+				LIST_FOREACH(clk, &priv->clocks, list) {
+					if (clk->servo) {
+						servo_reset(clk->servo);
+						clk->servo_state = SERVO_UNLOCKED;
+						pr_info("%s servo reset to s0 on Drive re-engage",
+							clk->name);
+					}
+				}
+			}
+
+			priv->gear        = new_gear;
+			priv->gear_source = GEAR_SRC_PMC;
+			pmc_send_response(pmc, msg, mgt_id,
+					  &priv->gear, sizeof(priv->gear));
+			break;
+		}
+		default:
+			break;
+		}
+		break;
+	}
+}
