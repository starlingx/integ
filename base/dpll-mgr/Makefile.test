# Makefile.test — unit test for update_pin_states (first dpll-mgr C test harness)
CC      ?= gcc
CFLAGS  := -g -O0 -std=gnu11 -D_GNU_SOURCE -Iinclude -I. -DUNIT_TEST_BUILD \
           -DSTATIC_PARAMS_FROM_CONFIG -DENABLE_PTP_SUBSCRIPTION -DUSE_GEAR_PARK \
           -DDPLL_IP_TIMING_DELAY -DDPLL_OP_TIMING_DELAY -DDPLL_ZL3073X_TIMING_DELAYS \
           -DDPLL_MGR_VERSION=\"test\" -DHAVE_DPLL_LOCK_STATUS_ERROR \
           -Wall -Wextra -Wno-unused-function -Wno-unused-parameter
LDLIBS  := -lgps -lcjson -lsystemd

YNL_OBJS := obj_test/ynl.o obj_test/dpll-user.o

.PHONY: test clean
test: run_test run_test_reconcile
	./run_test
	./run_test_reconcile

run_test: tests/test_update_pin_states.c $(YNL_OBJS)
	$(CC) $(CFLAGS) tests/test_update_pin_states.c $(YNL_OBJS) -o run_test $(LDLIBS)

run_test_reconcile: tests/test_reconcile_ptp_pins.c $(YNL_OBJS)
	$(CC) $(CFLAGS) tests/test_reconcile_ptp_pins.c $(YNL_OBJS) -o run_test_reconcile $(LDLIBS)

obj_test/%.o: ynl/%.c
	@mkdir -p obj_test
	$(CC) -std=gnu11 -O0 -Wall -Wno-unused-parameter -Wno-sign-compare -Iinclude -I. -c $< -o $@

clean:
	rm -rf obj_test run_test run_test_reconcile
