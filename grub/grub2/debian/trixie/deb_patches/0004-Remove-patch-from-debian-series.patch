- 
--#define GRUB_EFI_SECUREBOOT_MODE_UNSET		0
-+#define GRUB_EFI_SECUREBOOT_MODE_UNSET	0
- #define GRUB_EFI_SECUREBOOT_MODE_UNKNOWN	1
