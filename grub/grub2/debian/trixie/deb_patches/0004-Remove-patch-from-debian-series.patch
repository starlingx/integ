From f3bcb86b58efa7853d69944ffb915945f98cc4d3 Mon Sep 17 00:00:00 2001
From: Virgil Bucoci <virgil.bucoci@windriver.com>
Date: Tue, 28 Jul 2026 10:08:00 +0300
Subject: [PATCH 4/5] Remove patch from debian/series

Debian grub package includes a patch reverting 2 upstream commits that
are needed by later secure boot patches from upstream that we apply:

 0007-efi-sb-Add-support-for-the-shim-loader-protocol.patch
 0008-efi-sb-Add-API-for-retrieving-shim-loader-image-hand.patch
 0009-efi-sb-Fix-boot-failure-when-shim-validation-is-disa.patch

Signed-off-by: Virgil Bucoci <virgil.bucoci@windriver.com>
---
 .../revert-efi-fallback-to-legacy.patch       | 116 ------------------
 debian/patches/series                         |   1 -
 2 files changed, 117 deletions(-)
 delete mode 100644 debian/patches/secure-boot/revert-efi-fallback-to-legacy.patch

diff --git a/debian/patches/secure-boot/revert-efi-fallback-to-legacy.patch b/debian/patches/secure-boot/revert-efi-fallback-to-legacy.patch
deleted file mode 100644
index 56f94bb04..000000000
--- a/debian/patches/secure-boot/revert-efi-fallback-to-legacy.patch
+++ /dev/null
@@ -1,116 +0,0 @@
-From: Julian Andres Klode <julian.klode@canonical.com>
-Date: Wed, 19 Jul 2023 15:52:09 +0200
-Subject: Disable fallback to legacy mode if shim is loaded on x86 archs
-
-This reverts commits
-- 6425c12cd77ad51ad24be84c092aefacf0875089:
-  this originally adds the fallback
-- e60015f574024584e43d1b3b245551e864aa8c4d:
-  this triggers it in another case
----
- grub-core/kern/efi/sb.c      | 18 ------------------
- grub-core/loader/efi/linux.c | 17 -----------------
- include/grub/efi/sb.h        |  5 +----
- 3 files changed, 1 insertion(+), 39 deletions(-)
-
-diff --git a/grub-core/kern/efi/sb.c b/grub-core/kern/efi/sb.c
-index 8d3e413..80cfa08 100644
---- a/grub-core/kern/efi/sb.c
-+++ b/grub-core/kern/efi/sb.c
-@@ -32,8 +32,6 @@
- 
- static grub_guid_t shim_lock_guid = GRUB_EFI_SHIM_LOCK_GUID;
- 
--static bool shim_lock_enabled = false;
--
- /*
-  * Determine whether we're in secure boot mode.
-  *
-@@ -95,14 +93,6 @@ grub_efi_get_secureboot (void)
-   if (!(attr & GRUB_EFI_VARIABLE_RUNTIME_ACCESS) && *moksbstate == 1)
-     {
-       secureboot = GRUB_EFI_SECUREBOOT_MODE_DISABLED;
--      /*
--       * TODO: Replace this all with shim's LoadImage protocol, delegating policy to it.
--       *
--       * We need to set shim_lock_enabled here because we disabled secure boot
--       * validation *inside* shim but not in the firmware, so we set this variable
--       * here to trigger that code path, whereas the actual verifier is not enabled.
--       */
--      shim_lock_enabled = true;
-       goto out;
-     }
- 
-@@ -225,14 +215,6 @@ grub_shim_lock_verifier_setup (void)
-   /* Enforce shim_lock_verifier. */
-   grub_verifier_register (&shim_lock_verifier);
- 
--  shim_lock_enabled = true;
--
-   grub_env_set ("shim_lock", "y");
-   grub_env_export ("shim_lock");
- }
--
--bool
--grub_is_shim_lock_enabled (void)
--{
--  return shim_lock_enabled;
--}
