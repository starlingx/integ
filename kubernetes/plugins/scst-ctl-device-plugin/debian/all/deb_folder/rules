#!/usr/bin/make -f

%:
	dh $@ --buildsystem=golang

override_dh_auto_build:
	GO111MODULE=on go build -mod=vendor -ldflags="-s -w" \
		-o scst-ctl-device-plugin .

override_dh_auto_test:
	echo "do nothing"

override_dh_auto_install:
	install -d debian/scst-ctl-device-plugin/usr/local/bin
	install -m 755 scst-ctl-device-plugin \
		debian/scst-ctl-device-plugin/usr/local/bin/scst-ctl-device-plugin

override_dh_usrlocal:
	echo "do nothing"

override_dh_dwz:
	echo "do nothing"
